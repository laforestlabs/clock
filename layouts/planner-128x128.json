{
  "name": "planner",
  "canvas": { "width": 128, "height": 128 },
  "background": "#000000",
  "brightness": 200,

  "widgets": [
    { "type": "clock", "id": "clock",
      "rect": [2, 2, 70, 17],
      "font": "display-thin", "fit": true,
      "color": "#00E5FF", "align": "left" },

    { "type": "date", "id": "date",
      "rect": [74, 6, 52, 8],
      "font": "display-thin", "fit": true, "format": "%a %e %b",
      "color": "#7A8A99", "align": "right" },

    { "type": "line", "id": "rule-top",
      "rect": [2, 22, 124, 1],
      "color": "#1E2A33" },

    { "type": "icon", "id": "wx-icon",
      "rect": [2, 26, 16, 16],
      "icon_set": "wx16", "bind": "weather.code",
      "color": "#FFD24D",
      "colors": ["#C9CDD6", "#5AA0E0", "#E8EEF4"] },

    { "type": "text", "id": "temp",
      "rect": [22, 27, 44, 8],
      "font": "display-thin", "fit": true, "bind": "weather.temp",
      "color": "#FFFFFF" },

    { "type": "text", "id": "conditions",
      "rect": [22, 36, 44, 8],
      "font": "display-thin", "fit": true, "bind": "weather.label",
      "color": "#8899AA" },

    { "type": "text", "id": "high",
      "rect": [70, 27, 26, 8],
      "font": "display-thin", "fit": true, "bind": "weather.temp_max", "format": "H%.0f",
      "color": "#E06C5A" },

    { "type": "text", "id": "low",
      "rect": [98, 27, 26, 8],
      "font": "display-thin", "fit": true, "bind": "weather.temp_min", "format": "L%.0f",
      "color": "#5AA0E0" },

    { "type": "rect", "id": "card-agenda",
      "rect": [2, 46, 72, 80],
      "color": "#1E2A33", "bg": "#0A1620" },

    { "type": "text", "id": "agenda-header",
      "rect": [5, 49, 66, 8],
      "font": "display-thin", "fit": true, "text": "TODAY",
      "color": "#FF9F43" },

    { "type": "agenda", "id": "agenda",
      "rect": [5, 59, 66, 64],
      "font": "display-thin", "fit": true,
      "color": "#FFFFFF", "accent": "#66D9EF",
      "max_items": 5, "line_gap": 1, "show_time": true },

    { "type": "rect", "id": "card-todo",
      "rect": [76, 46, 50, 80],
      "color": "#1E2A33", "bg": "#0A1620" },

    { "type": "text", "id": "todo-header",
      "rect": [79, 49, 44, 8],
      "font": "display-thin", "fit": true, "text": "TODO",
      "color": "#FF9F43" },

    { "type": "todo", "id": "todo",
      "rect": [79, 59, 44, 64],
      "font": "display-thin", "fit": true,
      "color": "#DDDDDD", "accent": "#A0E060",
      "max_items": 6, "line_gap": 1, "hide_done": false }
  ]
}
