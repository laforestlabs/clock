{
  "name": "precip",
  "canvas": { "width": 64, "height": 32 },
  "background": "#000000",
  "brightness": 200,

  "widgets": [
    { "type": "text", "id": "high",
      "rect": [1, 1, 18, 7],
      "font": "display", "fit": true, "bind": "weather.temp_max", "format": "H%.0f",
      "color": "#E06C5A", "align": "left" },

    { "type": "text", "id": "low",
      "rect": [20, 1, 18, 7],
      "font": "display", "fit": true, "bind": "weather.temp_min", "format": "L%.0f",
      "color": "#5AA0E0", "align": "left" },

    { "type": "clock", "id": "clock",
      "rect": [40, 1, 23, 7],
      "font": "display", "fit": true, "format": "%l:%M",
      "color": "#FFFFFF", "align": "right" },

    { "type": "line", "id": "rule-top",
      "rect": [1, 10, 62, 1],
      "color": "#1E2A33" },

    { "type": "icon", "id": "drop",
      "rect": [2, 13, 12, 12],
      "icon_set": "wx16", "text": ":", "fit": true,
      "color": "#5AA0E0" },

    { "type": "precip", "id": "precip-chart",
      "rect": [16, 12, 47, 19],
      "color": "#5AA0E0", "accent": "#2A3B4D" }
  ]
}
