{
  "name": "weather",
  "canvas": { "width": 64, "height": 32 },
  "background": "#000000",
  "brightness": 200,

  "widgets": [
    { "type": "date", "id": "date",
      "rect": [0, 0, 40, 7],
      "font": "display-thin", "fit": true, "format": "%a %e %b",
      "color": "#7A8A99", "align": "left" },

    { "type": "text", "id": "place",
      "rect": [40, 0, 24, 7],
      "font": "display-thin", "fit": true, "bind": "weather.place",
      "color": "#5AA0E0", "align": "right" },

    { "type": "icon", "id": "wx-icon",
      "rect": [0, 8, 20, 20],
      "icon_set": "wx16", "bind": "weather.code", "fit": true,
      "color": "#FFD24D",
      "colors": ["#C9CDD6", "#5AA0E0", "#E8EEF4"] },

    { "type": "weather", "id": "wx-block",
      "rect": [22, 8, 42, 24],
      "font": "display-thin", "fit": true,
      "color": "#FFFFFF", "accent": "#66D9EF", "line_gap": 1 }
  ]
}
