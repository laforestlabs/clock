{
  "name": "weather",
  "canvas": { "width": 128, "height": 64 },
  "background": "#000000",
  "brightness": 200,

  "widgets": [
    { "type": "date", "id": "date",
      "rect": [2, 2, 60, 8],
      "font": "display", "fit": true, "format": "%A %e %b",
      "color": "#7A8A99", "align": "left" },

    { "type": "text", "id": "place",
      "rect": [64, 2, 62, 8],
      "font": "display", "fit": true, "bind": "weather.place",
      "color": "#5AA0E0", "align": "right" },

    { "type": "line", "id": "rule-top",
      "rect": [2, 12, 124, 1],
      "color": "#1E2A33" },

    { "type": "rect", "id": "card-left",
      "rect": [2, 15, 50, 47],
      "color": "#1E2A33", "bg": "#0A1620" },

    { "type": "icon", "id": "wx-icon",
      "rect": [6, 19, 20, 20],
      "icon_set": "wx16", "bind": "weather.code", "fit": true,
      "color": "#FFD24D",
      "colors": ["#C9CDD6", "#5AA0E0", "#E8EEF4"] },

    { "type": "weather", "id": "wx-block",
      "rect": [6, 41, 42, 18],
      "font": "display", "fit": true,
      "color": "#FFFFFF", "accent": "#66D9EF", "line_gap": 1 },

    { "type": "rect", "id": "card-right",
      "rect": [55, 15, 71, 47],
      "color": "#1E2A33", "bg": "#0A1620" },

    { "type": "text", "id": "wind-label",
      "rect": [59, 18, 63, 7],
      "font": "sans", "fit": true, "text": "WIND",
      "color": "#8899AA", "align": "left" },

    { "type": "text", "id": "wind",
      "rect": [59, 26, 63, 12],
      "font": "display", "fit": true, "bind": "weather.wind_kph", "format": "%.0f kph",
      "color": "#FFFFFF", "align": "left" },

    { "type": "line", "id": "rule-mid",
      "rect": [59, 41, 63, 1],
      "color": "#1E2A33" },

    { "type": "text", "id": "hum-label",
      "rect": [59, 44, 63, 7],
      "font": "sans", "fit": true, "text": "HUMIDITY",
      "color": "#8899AA", "align": "left" },

    { "type": "text", "id": "humidity",
      "rect": [59, 52, 63, 9],
      "font": "display", "fit": true, "bind": "weather.humidity_pct", "format": "%.0f%%",
      "color": "#FFFFFF", "align": "left" }
  ]
}
