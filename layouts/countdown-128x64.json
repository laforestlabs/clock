{
  "name": "countdown",
  "canvas": { "width": 128, "height": 64 },
  "background": "#000000",
  "brightness": 200,

  "widgets": [
    { "type": "rect", "id": "frame",
      "rect": [2, 2, 124, 60],
      "color": "#1E2A33", "bg": "#0A1620" },

    { "type": "text", "id": "title",
      "rect": [4, 5, 120, 8],
      "font": "display", "fit": true, "text": "NEW YEAR 2027",
      "color": "#FF9F43", "align": "center" },

    { "type": "countdown", "id": "countdown",
      "rect": [4, 16, 120, 30],
      "font": "display", "fit": true, "until": 1798761600,
      "color": "#FFFFFF", "align": "center", "valign": "middle" },

    { "type": "line", "id": "rule",
      "rect": [40, 49, 48, 1],
      "color": "#1E2A33" },

    { "type": "clock", "id": "clock",
      "rect": [4, 52, 120, 10],
      "font": "display", "fit": true, "format": "%H:%M:%S",
      "color": "#00E5FF", "align": "center" }
  ]
}
