{
  "name": "mini",
  "canvas": { "width": 64, "height": 32 },
  "background": "#000000",
  "brightness": 200,

  "widgets": [
    { "type": "clock", "id": "clock",
      "rect": [0, 0, 64, 16],
      "font": "digits16", "format": "%H:%M",
      "color": "#00E5FF", "align": "center" },

    { "type": "icon", "id": "wx-icon",
      "rect": [0, 16, 16, 16],
      "icon_set": "wx16", "bind": "weather.code",
      "color": "#FFC24D" },

    { "type": "text", "id": "temp",
      "rect": [18, 17, 46, 7],
      "font": "tom5x7", "bind": "weather.temp_c", "format": "%.0f\u00b0C",
      "color": "#FFFFFF" },

    { "type": "text", "id": "conditions",
      "rect": [18, 25, 46, 7],
      "font": "tom5x7", "bind": "weather.label",
      "color": "#8899AA" }
  ]
}
