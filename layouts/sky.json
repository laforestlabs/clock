{
  "name": "sky",
  "canvas": { "width": 64, "height": 32 },
  "background": "#000000",
  "brightness": 200,

  "widgets": [
    { "type": "date", "id": "date",
      "rect": [0, 0, 64, 7],
      "font": "display-thin", "fit": true, "format": "%a %e %b",
      "color": "#7A8A99", "align": "center" },

    { "type": "sun", "id": "sun",
      "rect": [0, 8, 64, 12],
      "font": "display-thin", "fit": true,
      "color": "#FFD24D", "accent": "#2A3B4D" },

    { "type": "moon", "id": "moon",
      "rect": [0, 20, 64, 12],
      "font": "display-thin", "fit": true,
      "color": "#E8EEF4", "accent": "#8899AA" }
  ]
}
