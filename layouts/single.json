{
  "name": "single",
  "canvas": { "width": 64, "height": 32 },
  "background": "#000000",
  "brightness": 200,

  "widgets": [
    { "type": "clock", "id": "clock",
      "rect": [0, 0, 64, 16],
      "font": "display", "fit": true,
      "color": "#00E5FF", "align": "center" },

    { "type": "icon", "id": "wx-icon",
      "rect": [0, 16, 16, 16],
      "icon_set": "wx16", "bind": "weather.code",
      "color": "#FFD24D",
      "colors": ["#C9CDD6", "#5AA0E0", "#E8EEF4"] },

    { "type": "text", "id": "temp",
      "rect": [18, 16, 46, 8],
      "font": "display", "fit": true, "bind": "weather.temp",
      "color": "#FFFFFF" },

    { "type": "date", "id": "date",
      "rect": [18, 24, 46, 8],
      "font": "display", "fit": true, "format": "%a %e %b",
      "color": "#7A8A99" }
  ]
}
