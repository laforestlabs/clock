{
  "name": "quad",
  "canvas": { "width": 128, "height": 128 },
  "background": "#000000",
  "brightness": 200,

  "widgets": [
    { "type": "clock", "id": "clock",
      "rect": [2, 2, 70, 17],
      "font": "digits16", "format": "%H:%M",
      "color": "#00E5FF", "align": "left" },

    { "type": "date", "id": "date",
      "rect": [74, 6, 52, 7],
      "font": "tom5x7", "format": "%a %e %b",
      "color": "#7A8A99", "align": "right" },

    { "type": "line", "id": "rule-top",
      "rect": [2, 22, 124, 1],
      "color": "#1E2A33" },

    { "type": "icon", "id": "wx-icon",
      "rect": [2, 26, 16, 16],
      "icon_set": "wx16", "bind": "weather.code",
      "color": "#FFC24D" },

    { "type": "text", "id": "temp",
      "rect": [22, 27, 40, 7],
      "font": "tom5x7", "bind": "weather.temp_c", "format": "%.0f\u00b0C",
      "color": "#FFFFFF" },

    { "type": "text", "id": "conditions",
      "rect": [22, 36, 40, 7],
      "font": "tom5x7", "bind": "weather.label",
      "color": "#8899AA" },

    { "type": "text", "id": "high",
      "rect": [68, 27, 28, 7],
      "font": "tom5x7", "bind": "weather.temp_max_c", "format": "H%.0f",
      "color": "#E06C5A" },

    { "type": "text", "id": "low",
      "rect": [98, 27, 28, 7],
      "font": "tom5x7", "bind": "weather.temp_min_c", "format": "L%.0f",
      "color": "#5AA0E0" },

    { "type": "text", "id": "wind",
      "rect": [68, 36, 58, 7],
      "font": "tom5x7", "bind": "weather.wind_kph", "format": "%.0f kph",
      "color": "#8899AA" },

    { "type": "line", "id": "rule-mid",
      "rect": [2, 47, 124, 1],
      "color": "#1E2A33" },

    { "type": "text", "id": "agenda-header",
      "rect": [2, 51, 60, 7],
      "font": "tom5x7", "text": "TODAY",
      "color": "#FF9F43" },

    { "type": "agenda", "id": "agenda",
      "rect": [2, 61, 124, 36],
      "font": "tom5x7",
      "color": "#FFFFFF", "accent": "#66D9EF",
      "max_items": 4, "line_gap": 2, "show_time": true },

    { "type": "line", "id": "rule-low",
      "rect": [2, 99, 124, 1],
      "color": "#1E2A33" },

    { "type": "text", "id": "todo-header",
      "rect": [2, 103, 60, 7],
      "font": "tom5x7", "text": "TODO",
      "color": "#FF9F43" },

    { "type": "todo", "id": "todo",
      "rect": [2, 113, 124, 15],
      "font": "tom5x7",
      "color": "#DDDDDD", "accent": "#A0E060",
      "max_items": 2, "line_gap": 1, "hide_done": true }
  ]
}
