{
  "name": "bigclock",
  "canvas": { "width": 64, "height": 32 },
  "background": "#000000",
  "brightness": 200,

  "widgets": [
    { "type": "clock", "id": "clock",
      "rect": [0, 0, 64, 24],
      "font": "digits", "fit": true, "format": "%H:%M",
      "color": "#00E5FF", "align": "center", "valign": "middle" },

    { "type": "date", "id": "date",
      "rect": [0, 24, 64, 8],
      "font": "display-thin", "fit": true, "format": "%a %e %b",
      "color": "#7A8A99", "align": "center" }
  ]
}
