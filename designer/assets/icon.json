{
  "name": "icon",
  "canvas": { "width": 64, "height": 64 },
  "background": "#000000",
  "brightness": 255,

  "widgets": [
    { "type": "rect", "id": "bezel",
      "rect": [2, 2, 60, 60],
      "color": "#5A8A99", "bg": "#0A1620" },

    { "type": "clock", "id": "clock",
      "rect": [4, 13, 56, 22],
      "font": "display", "fit": true,
      "color": "#00E5FF", "align": "center", "valign": "middle" },

    { "type": "line", "id": "rule",
      "rect": [8, 37, 48, 1],
      "color": "#33525E" },

    { "type": "icon", "id": "wx",
      "rect": [8, 41, 10, 10],
      "icon_set": "wx16", "bind": "weather.code",
      "color": "#FFD24D", "fit": true },

    { "type": "text", "id": "temp",
      "rect": [20, 42, 36, 10],
      "font": "display", "fit": true, "bind": "weather.temp_c",
      "format": "%.0f°", "color": "#FFFFFF",
      "align": "left", "valign": "middle" }
  ]
}
