# Defaults for the ESP32-S3-DevKitC-1 N16R8.
#
# sdkconfig itself is gitignored. Home WiFi credentials are never compiled
# in: the owner enters them through the setup portal on first boot and they
# are stored in the device's NVS.

CONFIG_IDF_TARGET="esp32s3"

# 16MB flash with the OTA-ready table in partitions.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Octal PSRAM (the R8 in N16R8). Note this consumes GPIO33 to GPIO37, which is
# why the panel pin map in docs/hardware.md avoids them and why the pinout in
# the esp-hub75 README does not work on this module.
#
# The HUB75 DMA buffer still lives in internal SRAM: PSRAM-backed buffers cap
# the shift clock near 13MHz and flicker visibly. PSRAM is here for TLS buffers
# and JSON parsing in M3.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# The render core already applies a CIE 1931 curve, and the golden-image tests
# assert the exact bytes that produces. The driver defaults to applying its own
# CIE 1931 curve on top, which would double-correct and come out far too dark.
# Linear here means "do not touch what we send you".
CONFIG_HUB75_GAMMA_LINEAR=y

# The Freenove FNK0085 routes its USB-C through the onboard CH343 to UART0
# (GPIO43/44), so the console lives there. The stock DevKitC-1 used the native
# USB-Serial-JTAG instead, which this board does not expose on the connector.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# The render task briefly holds the CPU while blitting a full frame.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Brownout detection matters here: an undersized 5V supply drooping under an
# all-white frame reads as a random firmware crash if this is off.
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The station connects with WPA2-PSK. WPA3 SAE is deliberately disabled: the
# driver's SAE negotiation is flaky against WPA2/WPA3 transition-mode routers
# (authentication rejected, reason 2), which are the norm now, while
# transition-mode networks still connect fine over their WPA2 half. The cost
# is that WPA3-only networks are unsupported, which is rare in homes.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
