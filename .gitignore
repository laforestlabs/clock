# Build output
build/
out/
*.o
*.so
*.a
*.elf
*.bin
*.map

# ESP-IDF
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Flutter and Dart
designer/.dart_tool/
designer/build/
designer/.flutter-plugins
designer/.flutter-plugins-dependencies
designer/pubspec.lock
designer/packages/*/.dart_tool/
designer/packages/*/pubspec.lock
designer/packages/*/build/

# Symlink to the shared layouts directory, created by designer/setup.sh
designer/assets/layouts

# Per-platform build scaffolding (gradle, podspecs, runner CMake) is version
# specific and is generated by designer/setup.sh with the locally installed
# Flutter. Committing a snapshot would go stale against other toolchains.
designer/android/
designer/ios/
designer/linux/
designer/macos/
designer/windows/
designer/packages/*/android/
designer/packages/*/ios/
designer/packages/*/linux/
designer/packages/*/macos/
designer/packages/*/windows/

# Test artifacts. Golden references are committed; actual output is not.
core/test/out/

# Local secrets: API tokens, WiFi credentials, calendar URLs
secrets.json
*.local.json
.env

# Editors
.vscode/
.idea/
*.swp
.DS_Store
